# Copier vers .env ou définir dans le panneau « Environment » du PaaS (ne pas commiter .env avec secrets).
#
# Obligatoire en production (déploiement cloud) :
# STOCKIA_SECRET_KEY=generer-une-chaine-longue-aleatoire-ex-openssl-rand-hex-32

# Optionnel : base de données
# Défaut local : sqlite sous backend/stockia.db
# Sur Azure App Service (WEBSITE_INSTANCE_ID) : défaut = sqlite:////home/stockia.db si le stockage
# persistant /home est activé — ajouter sur la Web App :
#   WEBSITES_ENABLE_APP_SERVICE_STORAGE=true
# STOCKIA_DATABASE_URL=sqlite:////home/stockia.db

# Tests : pytest utilise souvent une base isolée (voir conftest / doc README)
# STOCKIA_DATABASE_URL=sqlite:///./tests/test_stockia.db
